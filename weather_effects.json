{
  "version": 1,
  "notes": "Weather effects for the DM app. D&D 2024. Wind adds to the long rest DC: Calm 0, Breeze +2, Gust +5, Storm +10. Wind also changes the exposure DC: cold +1/+2/+4, heat -1/-2/-4 (exposureMod). Lookup: state (with season override) + wind. Travel and restDC are always shown; effect lines are optional reminders. Each effect has a category, an icon name, a tone (buff, nerf or neutral), a short label for the chip and the full text.",
  "travel": {"milesPerDay": {"slow": 18, "normal": 24, "fast": 30}, "minPercent": 25, "display": "Show percent and Normal pace miles/day, e.g. '75% (18 mi/day)'"},
  "exposureMinDC": 5,
  "states": {
    "sun1": { "name": "Clear", "travel": 100, "restDC": 5, "exposure": null, "effects": ["clearSight"],
      "seasons": { "summer": {"name": "Sunny"} } },
    "sun2": { "name": "Sunny", "travel": 100, "restDC": 5, "exposure": null, "effects": ["clearSight"],
      "seasons": { "winter": {"name": "Cold", "restDC": 10},
                  "summer": {"name": "Warm"} } },
    "sun3": { "name": "Warm", "travel": 100, "restDC": 5, "exposure": null, "effects": ["clearSight"],
      "seasons": { "summer": {"name": "Hot", "travel": 75, "restDC": 10, "exposure": {"dc": 14, "type": "heat"}, "effects": ["fireUp", "conSaveDown2"]},
                  "winter": {"name": "Frosty", "travel": 100, "restDC": 15, "exposure": {"dc": 12, "type": "cold"}, "effects": ["coldUp", "icyGround"]} } },
    "cloud1": { "name": "Cloudy", "travel": 100, "restDC": 5, "exposure": null, "effects": ["clearSight"] },
    "cloud2": { "name": "Overcast", "travel": 100, "restDC": 5, "exposure": null, "effects": [] },
    "cloud3": { "name": "Fog", "travel": 75, "restDC": 10, "exposure": null, "effects": ["lightly15", "heavily30", "stealthAdv"],
      "seasons": { "winter": {"name": "Icy", "effects": ["lightly15", "heavily30", "stealthAdv", "icyGround"]} } },
    "rain1": { "name": "Drizzle", "travel": 100, "restDC": 10, "exposure": null, "effects": ["lightly60"],
      "seasons": { "winter": {"name": "Light Snow"} } },
    "rain2": { "name": "Rain", "travel": 75, "restDC": 15, "exposure": null, "effects": ["lightly30", "heavily60", "flamesOut", "fireDown", "lightningUp", "stealthAdv", "hearingDisadv", "conSaveDown2"],
      "seasons": { "winter": {"name": "Snowfall", "effects": ["lightly30", "heavily60", "flamesOut", "coldUp", "stealthAdv", "deepSnow", "conSaveDown2"]} } },
    "rain3": { "name": "Downpour", "travel": 50, "restDC": 20, "exposure": null, "effects": ["lightly15", "heavily30", "flamesOut", "fireHalf", "lightningUp", "lightningAoe", "flyHalf", "muddyGround", "stealthAdv", "hearingDisadv", "conSaveDis"],
      "seasons": { "winter": {"name": "Blizzard", "exposure": {"dc": 15, "type": "cold"}, "effects": ["lightly0", "heavily30", "flamesOut", "coldUp", "deepSnow", "stealthAdv", "conSaveDis"]} } }
  },
  "wind": {
    "calm": {"name": "Calm", "travelMod": 0, "restDCMod": 0, "exposureMod": {"cold": 0, "heat": 0}, "effects": []},
    "breeze": {"name": "Breeze", "travelMod": 0, "restDCMod": 2, "exposureMod": {"cold": 1, "heat": -1}, "effects": ["cloudDrift"]},
    "gust": {"name": "Gust", "travelMod": 0, "restDCMod": 5, "exposureMod": {"cold": 2, "heat": -2}, "effects": ["rangeHalved", "cloudDisperse", "flyDifficult"]},
    "storm": {"name": "Storm", "travelMod": -25, "restDCMod": 10, "exposureMod": {"cold": 4, "heat": -4}, "effects": ["rangeHalved", "rangedDisadv", "cloudDisperse", "flyHalf", "flyMustLand", "hearingDisadv"]}
  },
  "categories": [
    {"key": "senses", "name": "Senses", "icon": "eye"},
    {"key": "damage", "name": "Damage", "icon": "flame"},
    {"key": "movement", "name": "Movement", "icon": "mountain"},
    {"key": "combat", "name": "Combat", "icon": "bow"},
    {"key": "survival", "name": "Survival", "icon": "thermo"}
  ],
  "effects": {
    "clearSight": {"cat": "senses", "icon": "eye", "tone": "buff", "short": "Sight adv.", "text": "Good visibility: Advantage on Perception to spot things far away"},
    "lightly0": {"cat": "senses", "icon": "eyeHalf", "tone": "nerf", "short": "Lightly 0 ft+", "text": "Lightly Obscured everywhere (Disadvantage on sight-based Perception)"},
    "lightly15": {"cat": "senses", "icon": "eyeHalf", "tone": "nerf", "short": "Lightly 15 ft+", "text": "Lightly Obscured beyond 15 ft (Disadvantage on sight-based Perception)"},
    "lightly30": {"cat": "senses", "icon": "eyeHalf", "tone": "nerf", "short": "Lightly 30 ft+", "text": "Lightly Obscured beyond 30 ft (Disadvantage on sight-based Perception)"},
    "lightly60": {"cat": "senses", "icon": "eyeHalf", "tone": "nerf", "short": "Lightly 60 ft+", "text": "Lightly Obscured beyond 60 ft (Disadvantage on sight-based Perception)"},
    "heavily30": {"cat": "senses", "icon": "eyeOff", "tone": "nerf", "short": "Heavily 30 ft+", "text": "Heavily Obscured beyond 30 ft"},
    "heavily60": {"cat": "senses", "icon": "eyeOff", "tone": "nerf", "short": "Heavily 60 ft+", "text": "Heavily Obscured beyond 60 ft"},
    "stealthAdv": {"cat": "senses", "icon": "mask", "tone": "buff", "short": "Stealth adv.", "text": "Advantage on Dexterity (Stealth) checks"},
    "hearingDisadv": {"cat": "senses", "icon": "earOff", "tone": "nerf", "short": "Hearing dis.", "text": "Noise: Disadvantage on Perception relying on hearing"},
    "fireUp": {"cat": "damage", "icon": "flame", "tone": "buff", "short": "Fire +2", "text": "Fire damage +2"},
    "fireDown": {"cat": "damage", "icon": "flame", "tone": "nerf", "short": "Fire -2", "text": "Fire damage -2"},
    "fireHalf": {"cat": "damage", "icon": "flame", "tone": "nerf", "short": "Fire ½", "text": "Fire damage is halved"},
    "coldUp": {"cat": "damage", "icon": "snow", "tone": "buff", "short": "Cold +2", "text": "Cold damage +2"},
    "lightningUp": {"cat": "damage", "icon": "bolt", "tone": "buff", "short": "Lightning +2", "text": "Lightning damage +2"},
    "lightningAoe": {"cat": "damage", "icon": "bolt", "tone": "buff", "short": "Lightning +5 ft AOE", "text": "Lightning damage also hits creatures adjacent to the target (+5 ft AOE)"},
    "muddyGround": {"cat": "movement", "icon": "mountain", "tone": "nerf", "short": "Mud", "text": "Unpaved ground outdoors is Difficult Terrain"},
    "deepSnow": {"cat": "movement", "icon": "mountain", "tone": "nerf", "short": "Deep snow", "text": "Snow-covered ground outdoors is Difficult Terrain"},
    "icyGround": {"cat": "movement", "icon": "mountain", "tone": "nerf", "short": "Ice: Dex DC 10", "text": "Dashing on ice: DC 10 Dex (Acrobatics) or fall Prone"},
    "flyDifficult": {"cat": "movement", "icon": "wing", "tone": "nerf", "short": "Flying hard", "text": "Flying counts as Difficult Terrain"},
    "flyHalf": {"cat": "movement", "icon": "wing", "tone": "nerf", "short": "Fly speed ½", "text": "Fly speed is halved"},
    "flyMustLand": {"cat": "movement", "icon": "wing", "tone": "nerf", "short": "Flyers land", "text": "Flyers without Hover must end their turn on the ground or fall"},
    "flamesOut": {"cat": "combat", "icon": "flameOff", "tone": "neutral", "short": "No open flame", "text": "Unprotected flames go out; fire can't ignite objects"},
    "rangeHalved": {"cat": "combat", "icon": "bow", "tone": "nerf", "short": "Range ½", "text": "Ranged weapon ranges halved"},
    "rangedDisadv": {"cat": "combat", "icon": "bow", "tone": "nerf", "short": "Ranged dis.", "text": "Disadvantage on ranged Weapon and Spell attacks"},
    "conSaveDown2": {"cat": "combat", "icon": "heart", "tone": "nerf", "short": "Con saves -2", "text": "Constitution saves against spell effects -2"},
    "conSaveDis": {"cat": "combat", "icon": "heart", "tone": "nerf", "short": "Con saves dis.", "text": "Disadvantage on Constitution saves (including to keep Concentration)"},
    "cloudDrift": {"cat": "combat", "icon": "cloud", "tone": "neutral", "short": "Clouds drift", "text": "Cloud spells drift 10 ft downwind each round"},
    "cloudDisperse": {"cat": "combat", "icon": "cloud", "tone": "neutral", "short": "Clouds fade", "text": "Cloud spells disperse at the end of the caster's next turn"}
  },
  "rules": {
    "combine": "Season override replaces fields of the base state. Travel = state.travel + wind.travelMod, min 25. Rest DC = state.restDC + wind.restDCMod. Effect list = state effects + wind effects, no duplicates.",
    "longRest": [
      "All characters roll for Survival as a group (50% must succeed) or individually.",
      "Tent or tarp: -5 DC. Cave, building or Tiny Hut: no roll.",
      "Fail: Long Rest but gain 1 Exhaustion and only half Hit Dice.",
      "Fail by 5+: Short Rest and 1 Exhaustion"
    ],
    "exposure": [
      "Every 4 hours of exposure make a constitution save vs the exposure DC. Fail: 1 Exhaustion.",
      "Protective gear gives Advantage.",
      "Fire or Cold resistance: automatic success.",
      "Wind raises the exposure DC in the cold and lowers it in the heat (never below the minimum DC)."
    ]
  }
}
